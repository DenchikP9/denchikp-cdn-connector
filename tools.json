      "name": "cdn_signed_link",
      "title": "Temporary link",
      "description": "Creates a signed link to a file that stops working after the given time. Useful for private files. Does not change the file.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "description": "Full file link: https://cdn.denchikp.com/<domain>/<folder>/<file>"
          },
          "ttl_seconds": {
            "type": "integer",
            "minimum": 10,
            "maximum": 2592000,
            "description": "Lifetime in seconds, 10 seconds to 30 days, default 3600"
          },
          "download": {
            "type": "boolean",
            "description": "Make the browser download the file instead of opening it"
          }
