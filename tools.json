    {
      "name": "cdn_upload_text",
      "title": "Upload a text file",
      "description": "Creates a new file from text (html, css, js, json, md, txt and so on) and returns its public link. Existing files are never overwritten.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "filename": {
            "type": "string",
            "description": "File name with extension, for example index.html"
          },
          "content": {
            "type": "string",
            "description": "File contents, UTF-8 text, up to 8 MB"
          },
          "domain": {
            "type": "string",
            "description": "Domain the file belongs to, for example example.com, or public. See cdn_account for the list."
          },
          "keep_filename": {
            "type": "boolean",
            "description": "Keep the file name exactly as given. By default the file gets a random unique name. If the name is taken, the upload is rejected."
          },
          "expires_in_seconds": {
            "type": "integer",
            "minimum": 60,
            "description": "Optional: delete the file automatically after this many seconds"
          }
        },
        "required": [
          "filename",
          "content"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "title": "Upload a text file",
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": true
      },
      "securitySchemes": [
        {
          "type": "oauth2",
          "scopes": [
            "upload"
          ]
        }
      ]
    },
    {
      "name": "cdn_upload_base64",
