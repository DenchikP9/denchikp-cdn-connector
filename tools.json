              ],
              "additionalProperties": false
            }
          },
          "domain": {
            "type": "string",
            "description": "Domain the file belongs to, for example example.com, or public. See cdn_account for the list."
          },
          "keep_filename": {
            "type": "boolean",
            "description": "Keep file names as given (default true)"
          },
          "expires_in_seconds": {
            "type": "integer",
            "minimum": 60,
            "description": "Optional: delete the files automatically after this many seconds"
