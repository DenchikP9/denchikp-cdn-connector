    {
      "name": "cdn_upload_text_batch",
      "title": "Upload several text files",
      "description": "Uploads up to 20 text files in one call (for example the html, css and js of a web page), 8 MB in total. File names are kept by default; existing files are never overwritten. Returns a link or an error for every file.",
