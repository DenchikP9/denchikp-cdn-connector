{
  "server": "https://cdnapi.denchikp.com/mcp",
  "version": "6.71.1",
  "tools": [
    {
      "name": "cdn_account",
      "title": "Account and quotas",
      "description": "Returns the API key name, plan, storage and traffic quotas, current usage and the domains this connector can upload to. Call it first to learn the available domains.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "annotations": {
        "title": "Account and quotas",
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "securitySchemes": [
        {
          "type": "oauth2",
          "scopes": [
            "read"
          ]
        }
      ]
    },
    {
      "name": "cdn_list_files",
      "title": "List files",
      "description": "Lists files uploaded with this API key, newest first, with optional search by name and filters by domain, folder and extension. Returns links, sizes and dates.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "Part of the file name"
          },
          "domain": {
            "type": "string",
            "description": "Domain the file belongs to, for example example.com, or public. See cdn_account for the list."
          },
          "folder": {
            "type": "string",
            "description": "Folder: img, css, js, fonts, video, audio, docs or files"
          },
          "extension": {
            "type": "string",
            "description": "Extension without the dot, for example png"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200,
            "description": "How many items to return, 1-200, default 50"
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "description": "How many items to skip, for paging"
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "annotations": {
        "title": "List files",
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "securitySchemes": [
        {
          "type": "oauth2",
          "scopes": [
            "read"
          ]
        }
      ]
    },
    {
      "name": "cdn_browse_domain",
      "title": "Browse a domain",
      "description": "Lists files stored on disk for a domain, including files uploaded by other keys of the same domain owner. Returns up to 200 files.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "domain": {
            "type": "string",
            "description": "Domain the file belongs to, for example example.com, or public. See cdn_account for the list."
          },
          "folder": {
            "type": "string",
            "description": "Folder: img, css, js, fonts, video, audio, docs or files"
          },
          "name_filter": {
            "type": "string",
            "description": "Part of the file name"
          }
        },
        "required": [
          "domain"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "title": "Browse a domain",
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "securitySchemes": [
        {
          "type": "oauth2",
          "scopes": [
            "read"
          ]
        }
      ]
    },
    {
      "name": "cdn_file_info",
